APP_NAME=VOID VORTEX
ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/void_vortex
REDIS_URL=redis://redis:6379/0
DOCKER_NETWORK=void_vortex_net
DOCKER_SOCKET=unix://var/run/docker.sock
DEPLOY_ROOT=/var/lib/void-vortex/deployments
BOT_LOG_ROOT=/var/lib/void-vortex/logs
GITHUB_CLONE_TIMEOUT=240
RATE_LIMIT_PER_MINUTE=120
STRIPE_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
